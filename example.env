# Current declarative firewall configuration; never sourced as shell.
# Read docs/configuration/README.md and docs/migration/README.md before deploying.
# Web, games and VPN examples are under config/profiles/.
# CLI overrides this file. Explicit empty required values fail.
PROFILE=host-minimal
MODULES_ONLY=""
MODULES_EXCLUDE=""
FAMILY_POLICY=dual
HOST_SERVICES=true
CONTAINER_POLICY=off
ROUTED_POLICY=drop

# Public SSH with per-source limits. Adapt the port before applying.
# ADMIN_SOURCES may contain explicit IPv4/IPv6 addresses or CIDRs.
SSH_PORT=22
SSH_RATE=60/minute
SSH_BURST=20
ADMIN_SOURCES=""
STATE_CAPACITY=8192
SSH_METER_TIMEOUT=1m

# Prefer scoped JSON grants over a privileged host bypass.
PRIVILEGED_BYPASS=false
BYPASS_SOURCE_IPS=""
BYPASS_SOURCE_DOMAINS=""
DNS_ALLOWED_CIDRS=""
ACCESS_POLICY=""

# Does not change system alternatives or Docker.
NF_TABLE_FAMILY=inet
NF_TABLE_NAME=firewall_main
IPTABLES_FRONTEND=auto
DOCKER_BACKEND=auto
DOCKER_INPUT_COMPAT=false
DOCKER_CHAIN_AUTORECOVER=false

# LOGFILE/RSYSLOG_CONF belong to log-summary, not this configuration.
# Persistence: ipp.sh save/load; see docs/firewall/persistence.md.
