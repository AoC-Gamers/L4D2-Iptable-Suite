[Unit]
Description=Verify suite policy availability in this boot
Documentation=file:/opt/l4d2-firewall/docs/security/boot-protection.md
Requires=l4d2-firewall.service
After=l4d2-firewall.service

[Service]
Type=oneshot
UMask=0077
ExecStart=/usr/bin/python3 -I /opt/l4d2-firewall/core/fw.py ready
# No persistent readiness based solely on an active unit or a state file.
