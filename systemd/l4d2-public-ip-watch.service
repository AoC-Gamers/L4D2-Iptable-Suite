[Unit]
Description=Detect Valpo2 public IPv4 changes and refresh L4D2 nftables
Documentation=file:/home/lechuga/L4D2-Iptable-Suite/docs/public-ip-watch.md
Wants=network-online.target
After=network-online.target nftables.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/l4d2-public-ip-watch
User=root
Group=root
UMask=0077
StateDirectory=l4d2-public-ip-watch
StateDirectoryMode=0700
RuntimeDirectory=l4d2-public-ip-watch
RuntimeDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/l4d2-public-ip-watch /run/l4d2-public-ip-watch
TimeoutStartSec=3min
