# Official No-IP external IPv4 detection service.
NOIP_CHECK_URL=http://ip1.dynupdate.no-ip.com/
NOIP_USER_AGENT="AoC-Gamers L4D2-Public-IP-Watch/1.0 admin@aoc-gamers.com"
HTTP_TIMEOUT_SECONDS=15

# Confirm that the router-updated No-IP record agrees with the observed WAN IP
# before changing firewall state. Two authoritative answers are required.
DDNS_HOSTNAME=games.example.net
DDNS_NAMESERVERS="ns1.no-ip.com ns2.no-ip.com ns3.no-ip.com ns4.no-ip.com"
DDNS_MIN_MATCHES=2
REQUIRE_DDNS_MATCH=true

# Production nftables entrypoint and its configuration.
FIREWALL_SCRIPT=/opt/l4d2-firewall/nftables.rules.sh
FIREWALL_ENV_FILE=/opt/l4d2-firewall/.env

# Optional executable invoked as: hook PREVIOUS_IP CURRENT_IP
# This can later issue an SRCDS/Steam master heartbeat if required.
POST_CHANGE_HOOK=

STATE_FILE=/var/lib/l4d2-public-ip-watch/current-ip
LOCK_FILE=/run/l4d2-public-ip-watch/watch.lock

# Must verify a fresh administrative connection from an independent host.
# Failure rolls back and prevents advancement of watcher state.
EXTERNAL_ADMIN_VERIFIER=/usr/local/libexec/check-new-admin-connection
